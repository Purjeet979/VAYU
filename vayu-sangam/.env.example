# VayuSangam Data Fetchers - Environment Variables

# DATA_MODE controls whether the backend uses live fetched data or bundled demo data.
# Options: "live", "demo" (default)
DATA_MODE=demo

# NASA FIRMS API Key for active fires
# Get one free instantly at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your_firms_map_key_here

# data.gov.in API Key for CPCB PM2.5/PM10 (Phase 2)
# Get one free at: https://data.gov.in/
CPCB_API_KEY=your_cpcb_api_key_here

# OpenAQ API Key (Fallback for CPCB)
# Get one free at: https://openaq.org/
OPENAQ_API_KEY=your_openaq_api_key_here

# Open-Meteo doesn't require a key
# Copernicus CDS API Key (Optional for ERA5)
CDSAPI_KEY=your_cdsapi_key_here

# Google Earth Engine Service Account key path (optional)
GEE_SERVICE_ACCOUNT_KEY_PATH=path/to/service_account.json
